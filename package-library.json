{
  "name": "astra-blogs-lib",
  "version": "3.1.7",
  "description": "A standalone JavaScript library for fetching and managing blog content from GitHub repositories. Framework-agnostic with support for React, Vue, Angular, Next.js, Node.js, and vanilla JavaScript.",
  "main": "astra-blogs-lib.js",
  "module": "astra-blogs-lib.js",
  "types": "astra-blogs-lib.d.ts",
  "files": [
    "astra-blogs-lib.js",
    "astra-blogs-lib.d.ts",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/index.js",
    "build": "echo 'Library is ready to use'",
    "minify": "terser astra-blogs-lib.js -o astra-blogs-lib.min.js",
    "docs": "echo 'Documentation files: LIBRARY_USAGE_GUIDE.md, FRAMEWORK_EXAMPLES.md'"
  },
  "keywords": [
    "blog",
    "github",
    "markdown",
    "cms",
    "content-management",
    "static-site",
    "react",
    "vue",
    "angular",
    "nextjs",
    "nodejs",
    "javascript",
    "fetch",
    "cache",
    "yaml",
    "frontmatter"
  ],
  "author": "Astra Blogs Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/astrablogsportal-code/astra-blogs-lib"
  },
  "bugs": {
    "url": "https://github.com/astrablogsportal-code/astra-blogs-lib/issues"
  },
  "homepage": "https://github.com/astrablogsportal-code/astra-blogs-lib#readme",
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "terser": "^5.27.0",
    "jsdoc": "^4.0.3"
  },
  "optionalDependencies": {
    "js-yaml": "^4.1.1"
  },
  "readme": "See LIBRARY_README.md for overview and LIBRARY_USAGE_GUIDE.md for complete documentation"
}
